#!/bin/sh
set -eu

# Git supplies the remote name and the refs that are about to be pushed.
[ "${1:-}" = origin ] || exit 0
target_commit=
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    case "$local_sha" in
      *[!0]*) target_commit=$local_sha ;;
    esac
  fi
done
[ -n "$target_commit" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
if [ "$(git rev-parse HEAD)" != "$target_commit" ]; then
  echo 'Release preparation stopped: check out the commit being pushed to origin/main, then push again.' >&2
  exit 1
fi

node tools/prepare-release.cjs

# Working-tree changes cannot be included in an already-started push.
pending=$(git status --porcelain -- index.html site.webmanifest version.json teams.json assets data tools/prepare-release.cjs)
if [ -n "$pending" ]; then
  echo 'Push stopped: release/runtime files have uncommitted changes.' >&2
  echo 'Review and commit them, then push again. Release files have been prepared.' >&2
  printf '%s\n' "$pending" >&2
  exit 1
fi
